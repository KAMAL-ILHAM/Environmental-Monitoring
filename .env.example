# ---------------------------------------------------------------
# Salin file ini menjadi `.env` lalu sesuaikan nilainya.
#   cp .env.example .env
# ---------------------------------------------------------------

# Koneksi PostgreSQL (format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public)
# Nilai di bawah cocok dengan docker-compose.yml bawaan proyek ini.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/esp32_monitor?schema=public"

# Kunci rahasia yang harus dikirim ESP32 lewat header `x-api-key`.
# Harus SAMA dengan API_KEY di esp32/esp32_dht22_monitor/config.h.
# Buat kunci acak, contoh:  openssl rand -hex 24
# Jika dikosongkan, endpoint POST tidak meminta kunci (hanya untuk uji lokal).
DEVICE_API_KEY="ganti-dengan-kunci-acak-yang-panjang"

# Perangkat dianggap OFFLINE jika data terakhir lebih lama dari nilai ini (detik).
# Rekomendasi: minimal 3x interval pengiriman ESP32 (default firmware = 10 detik).
OFFLINE_THRESHOLD_SECONDS=60
